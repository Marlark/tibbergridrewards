      "children": [
        {
          "id": "charger_state",
          "type": "label",
          "value": "–",
          "label": {
            "en": "The charger says",
            "sv": "Laddboxen säger",
            "no": "Laderen sier",
            "da": "Laderen siger",
            "de": "Die Wallbox meldet",
            "nl": "De laadpaal meldt"
          },
          "hint": {
            "en": "Report your charger’s state with the flow card “The charger says the car is …”. If the charger says plugged in but Tibber sees no car for 10 minutes, you get a warning.",
            "sv": "Rapportera laddboxens läge med Flow-kortet ”Laddboxen säger att bilen är …”. Om laddboxen säger inkopplad men Tibber inte ser någon bil på 10 minuter får du en varning.",
            "no": "Rapporter laderens tilstand med Flow-kortet «Laderen sier at bilen er …». Hvis laderen sier tilkoblet, men Tibber ikke ser noen bil på 10 minutter, får du en advarsel.",
            "da": "Rapportér laderens tilstand med Flow-kortet »Laderen siger, at bilen er …«. Hvis laderen siger tilsluttet, men Tibber ikke ser nogen bil i 10 minutter, får du en advarsel.",
            "de": "Melde den Zustand der Wallbox mit der Flow-Karte „Die Wallbox meldet, das Auto ist …“. Meldet die Wallbox angeschlossen, sieht Tibber aber 10 Minuten lang kein Auto, bekommst du eine Warnung.",
            "nl": "Meld de status van de laadpaal met de Flow-kaart ‘De laadpaal meldt dat de auto … is’. Meldt de laadpaal aangesloten maar ziet Tibber 10 minuten geen auto, dan krijg je een waarschuwing."
          }
        }

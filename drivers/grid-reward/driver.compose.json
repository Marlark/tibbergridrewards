{
  "name": {
    "en": "Grid Rewards",
    "sv": "Grid Rewards"
  },
  "class": "sensor",
  "capabilities": [
    "grid_reward_state",
    "grid_reward_active",
    "grid_reward_reason",
    "grid_reward_session",
    "grid_reward_session_estimate",
    "grid_reward_today",
    "grid_reward_yesterday",
    "grid_reward_month",
    "grid_reward_all_time",
    "grid_reward_last_session",
    "grid_reward_sessions_today",
    "grid_reward_minutes_today",
    "grid_reward_sessions_month",
    "grid_reward_availability"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "Tibber e-mail",
          "sv": "E-postadress hos Tibber",
          "no": "E-postadresse hos Tibber",
          "da": "E-mailadresse hos Tibber",
          "de": "E-Mail-Adresse bei Tibber",
          "nl": "E-mailadres bij Tibber"
        },
        "usernamePlaceholder": {
          "en": "name@example.com"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "Tibber e-mail",
          "sv": "E-postadress hos Tibber",
          "no": "E-postadresse hos Tibber",
          "da": "E-mailadresse hos Tibber",
          "de": "E-Mail-Adresse bei Tibber",
          "nl": "E-mailadres bij Tibber"
        },
        "usernamePlaceholder": {
          "en": "name@example.com"
        }
      }
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection status",
        "sv": "Anslutningsstatus",
        "no": "Tilkoblingsstatus",
        "da": "Forbindelsesstatus",
        "de": "Verbindungsstatus",
        "nl": "Verbindingsstatus"
      },
      "children": [
        {
          "id": "conn_status",
          "type": "label",
          "label": {
            "en": "Connection",
            "sv": "Anslutning",
            "no": "Tilkobling",
            "da": "Forbindelse",
            "de": "Verbindung",
            "nl": "Verbinding"
          },
          "value": "–"
        },
        {
          "id": "conn_last_update",
          "type": "label",
          "label": {
            "en": "Last update from Tibber",
            "sv": "Senaste uppdatering från Tibber",
            "no": "Siste oppdatering fra Tibber",
            "da": "Seneste opdatering fra Tibber",
            "de": "Letzte Aktualisierung von Tibber",
            "nl": "Laatste update van Tibber"
          },
          "value": "–"
        },
        {
          "id": "conn_connected_since",
          "type": "label",
          "label": {
            "en": "Connected since",
            "sv": "Ansluten sedan",
            "no": "Tilkoblet siden",
            "da": "Forbundet siden",
            "de": "Verbunden seit",
            "nl": "Verbonden sinds"
          },
          "value": "–"
        },
        {
          "id": "conn_reconnects",
          "type": "label",
          "label": {
            "en": "Reconnects since app start",
            "sv": "Återanslutningar sedan appstart",
            "no": "Nye tilkoblinger siden appstart",
            "da": "Genforbindelser siden appstart",
            "de": "Neuverbindungen seit App-Start",
            "nl": "Herverbindingen sinds app-start"
          },
          "value": "–"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Display",
        "sv": "Visning",
        "no": "Visning",
        "da": "Visning",
        "de": "Anzeige",
        "nl": "Weergave"
      },
      "children": [
        {
          "id": "show_updated",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Show \"Updated\" on the device",
            "sv": "Visa ”Uppdaterad” på enheten",
            "no": "Vis «Oppdatert» på enheten",
            "da": "Vis »Opdateret« på enheden",
            "de": "„Aktualisiert“ am Gerät anzeigen",
            "nl": "‘Bijgewerkt’ op het apparaat tonen"
          },
          "hint": {
            "en": "The time of the last update from Tibber, as a value on the device. It is always shown in the widget and under Connection status; as a value it is written on every update (about 150 times a day).",
            "sv": "Tiden för senaste uppdateringen från Tibber, som ett värde på enheten. Den visas alltid i widgeten och under Anslutningsstatus; som värde skrivs den vid varje uppdatering (ungefär 150 gånger per dygn).",
            "no": "Tidspunktet for siste oppdatering fra Tibber, som en verdi på enheten. Den vises alltid i widgeten og under Tilkoblingsstatus; som verdi skrives den ved hver oppdatering (omtrent 150 ganger i døgnet).",
            "da": "Tidspunktet for seneste opdatering fra Tibber, som en værdi på enheden. Den vises altid i widgetten og under Forbindelsesstatus; som værdi skrives den ved hver opdatering (cirka 150 gange i døgnet).",
            "de": "Der Zeitpunkt der letzten Aktualisierung von Tibber als Wert am Gerät. Er wird immer im Widget und unter Verbindungsstatus angezeigt; als Wert wird er bei jeder Aktualisierung geschrieben (etwa 150-mal am Tag).",
            "nl": "Het tijdstip van de laatste update van Tibber, als waarde op het apparaat. Het staat altijd in de widget en onder Verbindingsstatus; als waarde wordt het bij elke update geschreven (ongeveer 150 keer per dag)."
          }
        }
      ]
    }
  ]
}

{
  "name": {
    "en": "Grid Rewards",
    "sv": "Grid Rewards"
  },
  "class": "sensor",
  "capabilities": [
    "grid_reward_state",
    "grid_reward_active",
    "grid_reward_reason",
    "grid_reward_session",
    "grid_reward_today",
    "grid_reward_month",
    "grid_reward_all_time",
    "grid_reward_last_session",
    "grid_reward_sessions_today",
    "grid_reward_minutes_today",
    "grid_reward_sessions_month"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "Tibber e-mail",
          "sv": "E-postadress hos Tibber",
          "no": "E-postadresse hos Tibber",
          "da": "E-mailadresse hos Tibber",
          "de": "E-Mail-Adresse bei Tibber",
          "nl": "E-mailadres bij Tibber"
        },
        "usernamePlaceholder": {
          "en": "name@example.com"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "Tibber e-mail",
          "sv": "E-postadress hos Tibber",
          "no": "E-postadresse hos Tibber",
          "da": "E-mailadresse hos Tibber",
          "de": "E-Mail-Adresse bei Tibber",
          "nl": "E-mailadres bij Tibber"
        },
        "usernamePlaceholder": {
          "en": "name@example.com"
        }
      }
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection status",
        "sv": "Anslutningsstatus",
        "no": "Tilkoblingsstatus",
        "da": "Forbindelsesstatus",
        "de": "Verbindungsstatus",
        "nl": "Verbindingsstatus"
      },
      "children": [
        {
          "id": "conn_status",
          "type": "label",
          "label": {
            "en": "Connection",
            "sv": "Anslutning",
            "no": "Tilkobling",
            "da": "Forbindelse",
            "de": "Verbindung",
            "nl": "Verbinding"
          },
          "value": "–"
        },
        {
          "id": "conn_last_update",
          "type": "label",
          "label": {
            "en": "Last update from Tibber",
            "sv": "Senaste uppdatering från Tibber",
            "no": "Siste oppdatering fra Tibber",
            "da": "Seneste opdatering fra Tibber",
            "de": "Letzte Aktualisierung von Tibber",
            "nl": "Laatste update van Tibber"
          },
          "value": "–"
        },
        {
          "id": "conn_connected_since",
          "type": "label",
          "label": {
            "en": "Connected since",
            "sv": "Ansluten sedan",
            "no": "Tilkoblet siden",
            "da": "Forbundet siden",
            "de": "Verbunden seit",
            "nl": "Verbonden sinds"
          },
          "value": "–"
        },
        {
          "id": "conn_reconnects",
          "type": "label",
          "label": {
            "en": "Reconnects since app start",
            "sv": "Återanslutningar sedan appstart",
            "no": "Nye tilkoblinger siden appstart",
            "da": "Genforbindelser siden appstart",
            "de": "Neuverbindungen seit App-Start",
            "nl": "Herverbindingen sinds app-start"
          },
          "value": "–"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Developer",
        "sv": "Utvecklare",
        "no": "Utvikler",
        "da": "Udvikler",
        "de": "Entwickler",
        "nl": "Ontwikkelaar"
      },
      "children": [
        {
          "id": "record_raw",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Record raw data",
            "sv": "Spela in rådata",
            "no": "Ta opp rådata",
            "da": "Optag rådata",
            "de": "Rohdaten aufzeichnen",
            "nl": "Ruwe gegevens opnemen"
          },
          "hint": {
            "en": "Writes every update from Tibber to the app log (lines starting with [REC]). Use during `homey app run` and extract with tools/extract-recording.js.",
            "sv": "Skriver varje uppdatering från Tibber till apploggen (rader som börjar med [REC]). Använd under `homey app run` och plocka ut med tools/extract-recording.js.",
            "no": "Skriver hver oppdatering fra Tibber til appens logg (linjer som begynner med [REC]). Bruk under `homey app run` og hent ut med tools/extract-recording.js.",
            "da": "Skriver hver opdatering fra Tibber til appens log (linjer, der begynder med [REC]). Brug under `homey app run` og udtræk med tools/extract-recording.js.",
            "de": "Schreibt jede Aktualisierung von Tibber ins App-Log (Zeilen, die mit [REC] beginnen). Während `homey app run` verwenden und mit tools/extract-recording.js extrahieren.",
            "nl": "Schrijft elke update van Tibber naar het app-logboek (regels die beginnen met [REC]). Gebruik tijdens `homey app run` en haal ze eruit met tools/extract-recording.js."
          }
        }
      ]
    }
  ]
}
